<idea-plugin>
    <id>com.github.clarity</id>
    <name>Clarity</name>
    <vendor>franfrandev</vendor>
    <description><![CDATA[
        Adds a filter that excludes usages located in tests.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="rust.xml">com.jetbrains.rust</depends>
    <depends optional="true" config-file="toml.xml">org.toml.lang</depends>
    <depends optional="true" config-file="go.xml">org.jetbrains.plugins.go</depends>
    <extensions defaultExtensionNs="com.intellij">
        <usageFilteringRuleProvider implementation="com.github.clarity.ui.LangUsageFilteringRuleProvider"/>
    </extensions>
    <actions>
        <action id="Clarity.ExcludeUsagesInTests"
                class="com.intellij.openapi.actionSystem.EmptyAction"
                text="Exclude Usages in Tests"
                description="Hide usages inside Rust and Go tests"
                icon="AllIcons.Actions.Close">
            <add-to-group group-id="UsageFilteringActionGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
